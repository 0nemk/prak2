$(function(){
let top=$(".header");
let topH=top.height();
let header=$(".header");
let scrollPos=$(window).scrollTop();

$(window).on("scroll",function(){
scrollPos=$(window).scrollTop();
console.log(scrollPos);
if (scrollPos>topH){
header.addClass("fixed");
}
else{
header.removeClass("fixed");
}
});
console.log(topH);
});